<Window x:Class="EuroSearchApp.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroLauncher Suite" Width="1280" Height="800" Background="#F1F5F9" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Resources>
        <Storyboard x:Key="SmoothBackgroundAnim">
            <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetName="TransformedBackground" Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)" From="0" To="-400" Duration="0:0:15" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SmoothBackgroundAnim}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid SnapsToDevicePixels="True">
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="TransformedBackground" Width="2500" Height="1500">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#00CCCC" />
                        <GradientStop Offset="0.5" Color="#FFFFFF" />
                        <GradientStop Offset="1" Color="#00CCCC" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Border.RenderTransform>
            </Border>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,60,0,0">
                <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Text="Καλώς ήρθατε στην Europharmacy" />
                <Border Width="150" Height="3" Margin="0,20,0,0" Background="#0066CC" CornerRadius="1.5" Opacity="0.6" />
            </StackPanel>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Resources>
                    <Style x:Key="LauncherCardStyle" TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MainBorder" Padding="30" Background="#CCFFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MainBorder" Property="Background" Value="White" />
                                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="#0066CC" />
                                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <StackPanel Orientation="Horizontal">
                    <Button Width="350" Height="250" Margin="20" Click="OpenEuroWheel_Click" Style="{StaticResource LauncherCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <Image Width="60" Height="60" Margin="0,0,0,15" Source="Assets/EuroWheelAppLogoHD.png" />
                            <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="EuroWheel" />
                            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" Text="Αναζήτηση &amp; Στατιστικά" />
                        </StackPanel>
                    </Button>

                    <Button Width="350" Height="250" Margin="20" Click="BtnEuroStatement_Click" Style="{StaticResource LauncherCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <Image Width="60" Height="60" Margin="0,0,0,15" Source="Assets/EuroStatementLogo.png" />
                            <TextBlock HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="EuroPromotion" />
                            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" Text="Δελτίο &amp; Υπογραφή" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>