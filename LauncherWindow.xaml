<Window x:Class="EuroSearchApp.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroSearch Suite - Κεντρικό Μενού" Width="1280" Height="800" AllowsTransparency="False" Background="#F1F5F9" Icon="Assets/EuroWheelAppLogoHD.png" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowState="Maximized">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.4" Duration="0:0:5" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.6" Duration="0:0:5" />

                    <ColorAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Color" From="#660099" To="#0066CC" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="LineStop2" Storyboard.TargetProperty="Color" From="#00CCCC" To="#33CC66" Duration="0:0:3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="back1" Offset="0.0" Color="#00CCCC" />
                    <GradientStop x:Name="back2" Offset="0.5" Color="#fff" />
                    <GradientStop x:Name="back3" Offset="1.0" Color="#00CCCC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Grid.Row="0" Margin="0,40,0,0" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Text="Καλώς ήρθατε στην Europharmacy" />
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="#64748B" Text="Επιλέξτε τη λειτουργία που επιθυμείτε" />

            <Border Width="150" Height="3" Margin="0,20,0,0" CornerRadius="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="LineStop1" Offset="0.0" Color="#660099" />
                        <GradientStop x:Name="LineStop2" Offset="1.0" Color="#00CCCC" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.Resources>
                <Style x:Key="LauncherCardStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
                                    <Border x:Name="BlurLayer" Background="#AAFFFFFF" CornerRadius="20" Opacity="0.7">
                                        <Border.Effect>
                                            <BlurEffect Radius="20" />
                                        </Border.Effect>
                                    </Border>

                                    <Border Padding="30" Background="White" CornerRadius="20">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="CardShadow" BlurRadius="25" Opacity="0.15" ShadowDepth="5" Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Border.Effect>
                                        <ContentPresenter />
                                    </Border>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="35" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="BlurLayer" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="25" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="BlurLayer" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <StackPanel Orientation="Horizontal">
                <Button Width="380" Height="280" Margin="20" Click="OpenEuroWheel_Click" Cursor="Hand" Style="{StaticResource LauncherCardStyle}" Tag="#0066CC">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,25">
                            <Ellipse Width="100" Height="100" Fill="#0066CC" Opacity="0.1" />
                            <Image Width="70" Height="70" RenderOptions.BitmapScalingMode="HighQuality" Source="Assets/EuroWheelAppLogoHD.png" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Text="EuroWheel" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" Text="Αναζήτηση &amp; Στατιστικά" />
                        <Border Width="60" Height="4" Margin="0,20,0,0" Background="#0066CC" CornerRadius="2" />
                    </StackPanel>
                </Button>

                <Button Width="380" Height="280" Margin="20" Click="BtnEuroStatement_Click" Cursor="Hand" Style="{StaticResource LauncherCardStyle}" Tag="#660099">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,25">
                            <Ellipse Width="100" Height="100" Fill="#660099" Opacity="0.1" />
                            <Image Width="70" Height="70" RenderOptions.BitmapScalingMode="HighQuality" Source="Assets/EuroStatementLogo.png" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Text="EuroStatement" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="#64748B" Text="Δελτίο &amp; Υπογραφή" />
                        <Border Width="60" Height="4" Margin="0,20,0,0" Background="#660099" CornerRadius="2" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>