<Window x:Class="EuroSearchApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroSearch" Loaded="Window_Loaded" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" From="#660099" To="#660099" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="Stop2" Storyboard.TargetProperty="Color" From="#00CCCC" To="#33CC66" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="Stop3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />

                    <ColorAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Color" From="#660099" To="#0066CC" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="LineStop2" Storyboard.TargetProperty="Color" From="#00CCCC" To="#33CC66" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.4" Duration="0:0:5" />
                    <DoubleAnimation Storyboard.TargetName="LineStop3" Storyboard.TargetProperty="Offset" From="1.0" To="0.6" Duration="0:0:5" />

                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />

                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.4" Duration="0:0:5" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.6" Duration="0:0:5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="back1" Offset="0.0" Color="#00CCCC" />
                <GradientStop x:Name="back2" Offset="0.5" Color="#fff" />
                <GradientStop x:Name="back3" Offset="1.0" Color="#00CCCC" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.Resources>
                <SolidColorBrush x:Key="Primary" Color="#3B82F6" />
                <SolidColorBrush x:Key="PrimaryLight" Color="#EFF6FF" />
                <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
                <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
                <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
                <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9" />

                <Style x:Key="SuggestionListBoxStyle" TargetType="ListBox">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                    <Style.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#3B82F6" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF" />
                                                <Setter Property="Foreground" Value="#3B82F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Style.Resources>
                </Style>

                <Style x:Key="ModernTextBox" TargetType="TextBox">
                    <Setter Property="Height" Value="42" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnPrimary" TargetType="Button">
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Background" Value="{StaticResource Primary}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform CenterX="50" CenterY="20" ScaleX="0.98" ScaleY="0.98" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnOutline" TargetType="Button">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnIcon" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Padding="8" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="RowHeaderWidth" Value="0" />
                    <Setter Property="GridLinesVisibility" Value="All" />
                    <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
                    <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0" />
                    <Setter Property="HeadersVisibility" Value="Column" />
                    <Setter Property="RowHeight" Value="48" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{StaticResource TextDark}" />
                    <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBg}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Foreground" Value="#DC2626" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#FEF2F2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="ModernComboBox" TargetType="ComboBox">
                    <Setter Property="Height" Value="42" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" />
                                            <ToggleButton Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent">
                                                            <Path Width="10" Height="6" Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M7,10L12,15L17,10H7Z" Fill="#64748B" Stretch="Uniform" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="8">
                                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsDropDownOpen" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="Stop1" Offset="0.0" Color="#53DDDD" />
                        <GradientStop x:Name="Stop2" Offset="0.5" Color="#0066CC" />
                        <GradientStop x:Name="Stop3" Offset="1.0" Color="#660099" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Height="36" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/EuroSearchAppLogo.png" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="EuroSearch" />
                        <Border Margin="10,0,0,0" Padding="10,4" VerticalAlignment="Center" Background="White" CornerRadius="6">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Width="12" Height="12" Margin="0,0,6,0" Data="M5,16L3,5L8.5,10L12,4L15.5,10L21,5L19,16H5M19,19C19,19.6 18.6,20 18,20H6C5.4,20 5,19.6 5,19V18H19V19Z" Fill="{StaticResource Primary}" Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Primary}" Text="PRO" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="120" Margin="0,0,12,0" Click="ExportVisible_Click" Style="{StaticResource BtnOutline}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" Data="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z" Fill="White" Stretch="Uniform" />
                                <TextBlock Text="Εξαγωγή" />
                            </StackPanel>
                        </Button>
                        <Button Width="40" Height="40" Click="OpenSettings_Click" Style="{StaticResource BtnIcon}" ToolTip="Ρυθμίσεις ΑΑΔΕ">
                            <Path Width="18" Height="18" Data="M19.14,12.94C19.14,12.78 19.14,12.61 19.14,12.44C19.14,12.27 19.14,12.11 19.14,11.94L21.41,10.19C21.62,10.03 21.68,9.75 21.56,9.5L19.5,6.08C19.38,5.83 19.06,5.75 18.81,5.83L16.14,6.94C15.61,6.5 15,6.17 14.38,5.89L13.94,3C13.94,2.75 13.69,2.56 13.44,2.56H9.44C9.19,2.56 8.94,2.75 8.94,3L8.5,5.89C7.88,6.14 7.25,6.5 6.75,6.94L4.06,5.83C3.81,5.75 3.5,5.83 3.38,6.08L1.31,9.5C1.19,9.75 1.25,10.03 1.44,10.19L3.75,11.94C3.75,12.11 3.75,12.28 3.75,12.44C3.75,12.61 3.75,12.78 3.75,12.94L1.44,14.69C1.25,14.86 1.19,15.14 1.31,15.39L3.38,18.81C3.5,19.06 3.81,19.14 4.06,19.06L6.75,17.94C7.25,18.39 7.88,18.75 8.5,19L8.94,21.89C8.94,22.14 9.19,22.33 9.44,22.33H13.44C13.69,22.33 13.94,22.14 13.94,21.89L14.38,19C15,18.72 15.61,18.39 16.14,17.94L18.81,19.06C19.06,19.14 19.38,19.06 19.5,18.81L21.56,15.39C21.68,15.14 21.62,14.86 21.41,14.69L19.14,12.94M11.44,15.44C9.75,15.44 8.44,14.11 8.44,12.44C8.44,10.78 9.75,9.44 11.44,9.44C13.11,9.44 14.44,10.78 14.44,12.44C14.44,14.11 13.11,15.44 11.44,15.44Z" Fill="White" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="24" ClipToBounds="True" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,20" Background="White" CornerRadius="10">
                        <Grid Margin="24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <StackPanel Width="280" Margin="0,0,20,0">
                                    <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΟΝΟΜΑΤΕΠΩΝΥΜΟ" />
                                    <Grid>
                                        <TextBox x:Name="TxtName" Padding="42,0,10,0" KeyDown="Input_KeyDown" Style="{StaticResource ModernTextBox}" Text="{Binding NameQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 1,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7.01,14 5,11.99 5,9.5C5,7.01 7.01,5 9.5,5C11.99,5 14,7.01 14,9.5C14,11.99 11.99,14 9.5,14Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />

                                        <Popup x:Name="PopName" AllowsTransparency="True" IsOpen="{Binding IsNamePopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=TxtName}" PopupAnimation="Slide" StaysOpen="False">
                                            <Border Width="280" Margin="0,4,0,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15" RenderingBias="Quality" ShadowDepth="3" />
                                                </Border.Effect>
                                                <ListBox x:Name="LstNameSuggestions" MaxHeight="250" ItemsSource="{Binding NameSuggestions}" SelectionChanged="Suggestion_SelectionChanged" Style="{StaticResource SuggestionListBoxStyle}" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Width="220" Margin="0,0,20,0">
                                    <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΤΗΛΕΦΩΝΟ" />
                                    <Grid>
                                        <TextBox x:Name="TxtPhone" Padding="42,0,10,0" KeyDown="Input_KeyDown" Style="{StaticResource ModernTextBox}" Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                        <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />

                                        <Popup x:Name="PopPhone" AllowsTransparency="True" IsOpen="{Binding IsPhonePopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=TxtPhone}" PopupAnimation="Slide" StaysOpen="False">
                                            <Border Width="220" Margin="0,4,0,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15" RenderingBias="Quality" ShadowDepth="3" />
                                                </Border.Effect>
                                                <ListBox x:Name="LstPhoneSuggestions" MaxHeight="250" ItemsSource="{Binding PhoneSuggestions}" SelectionChanged="Suggestion_SelectionChanged" Style="{StaticResource SuggestionListBoxStyle}" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Width="180" Margin="0,0,20,0">
                                    <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΚΑΤΑΣΤΑΣΗ" />
                                    <Grid>
                                        <ComboBox Padding="42,0,10,0" SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="Όλα" />
                                            <ComboBoxItem Content="Επιλεγμένα (Checked)" />
                                            <ComboBoxItem Content="Μη Επιλεγμένα" />
                                        </ComboBox>
                                        <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M3,6H21V8H3V6M6,11H18V13H6V11M10,16H14V18H10V16Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="Α.Φ.Μ." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="TxtAfm" Padding="42,0,10,0" KeyDown="Input_KeyDown" Style="{StaticResource ModernTextBox}" Text="{Binding AfmQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                            <Path Width="18" Height="18" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,18H4V6H20V18M12,14H18V16H12V14M12,8H18V10H12V8M6,8H10V12H6V8M6,14H10V16H6V14Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />

                                            <Popup x:Name="PopAfm" AllowsTransparency="True" IsOpen="{Binding IsAfmPopupOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=TxtAfm}" PopupAnimation="Slide" StaysOpen="False">
                                                <Border Width="180" Margin="0,4,0,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15" RenderingBias="Quality" ShadowDepth="3" />
                                                    </Border.Effect>
                                                    <ListBox x:Name="LstAfmSuggestions" MaxHeight="250" ItemsSource="{Binding AfmSuggestions}" SelectionChanged="Suggestion_SelectionChanged" Style="{StaticResource SuggestionListBoxStyle}" />
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button Grid.Column="1" Width="35" Margin="5,0,0,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Click="Aade_Click" Cursor="Hand" ToolTip="Αναζήτηση ΑΦΜ στην υπηρεσία ΑΑΔΕ">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource BtnPrimary}" TargetType="Button">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=TxtAfm, Path=Text.Length}" Value="9">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                            <Setter Property="Opacity" Value="1.0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Width="16" Height="16" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#3B82F6" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="Transparent" Text="." />
                                <Button Width="42" Height="42" Background="#F1F5F9" Click="ResetFilters_Click" Style="{StaticResource BtnIcon}" ToolTip="Καθαρισμός Φίλτρων">
                                    <Path Width="16" Height="16" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="#EF4444" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,0,0,20" Background="White" CornerRadius="10">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Border Margin="0,0,12,0" Padding="8" Background="#EFF6FF" CornerRadius="8">
                                    <Path Width="16" Height="16" Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Fill="#3B82F6" Stretch="Uniform" />
                                </Border>
                                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#64748B" Text="Βρέθηκαν:" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Text="{Binding ResultCount}" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B" Text="εγγραφές" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,0,0,24" Background="White" ClipToBounds="True">
                        <Grid>
                            <Border Height="4" VerticalAlignment="Top" Panel.ZIndex="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="LineStop1" Offset="0.0" Color="#660099" />
                                        <GradientStop x:Name="LineStop2" Offset="0.5" Color="#0066CC" />
                                        <GradientStop x:Name="LineStop3" Offset="1.0" Color="#660099" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <DataGrid x:Name="RecordsGrid" Margin="0,4,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableColumnVirtualization="True" EnableRowVirtualization="True" IsReadOnly="False"
                                      ItemsSource="{Binding SelectedRecordsView}"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False" SelectionMode="Extended" SelectionUnit="FullRow" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="150" Binding="{Binding Comments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Header="ΣΥΜΜΕΤΈΧΩΝ" IsReadOnly="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="5,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Padding" Value="2" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="*" Binding="{Binding Επωνυμία}" Header="ΕΠΩΝΥΜΙΑ" IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding ΑΦΜ}" Header="Α.Φ.Μ." IsReadOnly="True" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Τηλέφωνο}" Header="ΤΗΛΕΦΩΝΟ" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="220" Header="ΔΩΡΑ">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ComboGifts" Height="32" DisplayMemberPath="Eidos" ItemsSource="{Binding DataContext.GiftsList, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding SelectedGift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Eidos" Style="{StaticResource ModernComboBox}" />
                                                    <Button Grid.Column="1" Width="30" Height="30" Margin="4,0,0,0" Click="GiftInfo_Click" Style="{StaticResource BtnIcon}" ToolTip="Πληροφορίες Δώρων">
                                                        <Path Width="14" Height="14" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{StaticResource Primary}" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>