<Window x:Class="EuroSearchApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Excel Search" Loaded="Window_Loaded" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" From="#0F172A" To="#1E3A8A" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="Stop2" Storyboard.TargetProperty="Color" From="#3B82F6" To="#2563EB" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="Stop3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />

                    <ColorAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Color" From="#0F172A" To="#1E3A8A" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="LineStop2" Storyboard.TargetProperty="Color" From="#3B82F6" To="#2563EB" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.4" Duration="0:0:5" />
                    <DoubleAnimation Storyboard.TargetName="LineStop3" Storyboard.TargetProperty="Offset" From="1.0" To="0.6" Duration="0:0:5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.2" ShadowDepth="10" Color="#1E293B" />
        </Border.Effect>

        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.Resources>
                <SolidColorBrush x:Key="Primary" Color="#3B82F6" />
                <SolidColorBrush x:Key="PrimaryLight" Color="#EFF6FF" />
                <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
                <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
                <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
                <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9" />

                <Style x:Key="ModernTextBox" TargetType="TextBox">
                    <Setter Property="Height" Value="42" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}" />
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.15" ShadowDepth="0" Color="#3B82F6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnPrimary" TargetType="Button">
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Background" Value="{StaticResource Primary}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                                        <Setter TargetName="bd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform CenterX="50" CenterY="20" ScaleX="0.98" ScaleY="0.98" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnOutline" TargetType="Button">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="BtnIcon" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Padding="8" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="RowHeaderWidth" Value="0" />
                    <Setter Property="GridLinesVisibility" Value="Horizontal" />
                    <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
                    <Setter Property="HeadersVisibility" Value="Column" />
                    <Setter Property="RowHeight" Value="48" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{StaticResource TextDark}" />
                    <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBg}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Foreground" Value="#DC2626" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#FEF2F2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="ModernComboBox" TargetType="ComboBox">
                    <Setter Property="Height" Value="42" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" />
                                            <ToggleButton Grid.Column="0" Grid.ColumnSpan="2" ClickMode="Press" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent">
                                                            <Path Width="10" Height="6" Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M7,10L12,15L17,10H7Z" Fill="#64748B" Stretch="Uniform" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                                <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="3" Color="Black" />
                                                        </Border.Effect>
                                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsDropDownOpen" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}" />
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.15" ShadowDepth="0" Color="#3B82F6" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18" CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="Stop1" Offset="0.0" Color="#0F172A" />
                        <GradientStop x:Name="Stop2" Offset="0.5" Color="#3B82F6" />
                        <GradientStop x:Name="Stop3" Offset="1.0" Color="#0F172A" />
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.04" ShadowDepth="4" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Height="36" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/EuroSearchAppLogo.png" />
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="EuroSearch" />

                        <Border Margin="10,0,0,0" Padding="10,4" VerticalAlignment="Center" Background="White" CornerRadius="6">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Primary}" Text="PRO" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="120" Margin="0,0,12,0" Click="OpenExportMenu_Click" Style="{StaticResource BtnOutline}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="ExportAll_Click" Header="Εξαγωγή Όλων (All)" />
                                    <MenuItem Click="ExportUnchecked_Click" Header="Εξαγωγή Μη Επιλεγμένων (Unchecked)" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" Data="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z" Fill="White" Stretch="Uniform" />
                                <TextBlock Text="Εξαγωγή" />
                            </StackPanel>
                        </Button>

                        <Button Width="40" Height="40" Click="Close_Click" Style="{StaticResource BtnIcon}">
                            <Path Width="12" Height="12" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="White" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="24,24,24,12" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="300" Margin="0,0,24,0">
                            <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΟΝΟΜΑΤΕΠΩΝΥΜΟ" />
                            <Grid>
                                <TextBox Padding="42,0,10,0" Style="{StaticResource ModernTextBox}" Text="{Binding NameQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 1,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7.01,14 5,11.99 5,9.5C5,7.01 7.01,5 9.5,5C11.99,5 14,7.01 14,9.5C14,11.99 11.99,14 9.5,14Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Width="240" Margin="0,0,24,0">
                            <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΤΗΛΕΦΩΝΟ" />
                            <Grid>
                                <TextBox Padding="42,0,10,0" Style="{StaticResource ModernTextBox}" Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Width="180" Margin="24,0,24,0">
                            <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="ΚΑΤΑΣΤΑΣΗ" />
                            <Grid>
                                <ComboBox Padding="42,0,10,0" SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Όλα" />
                                    <ComboBoxItem Content="Επιλεγμένα (Checked)" />
                                    <ComboBoxItem Content="Μη Επιλεγμένα" />
                                </ComboBox>
                                <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M3,6H21V8H3V6M6,11H18V13H6V11M10,16H14V18H10V16Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Width="180">
                            <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="Α.Φ.Μ." />
                            <Grid>
                                <TextBox Padding="42,0,10,0" Style="{StaticResource ModernTextBox}" Text="{Binding AfmQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Width="18" Height="18" Margin="14,0,0,0" HorizontalAlignment="Left" Data="M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,18H4V6H20V18M12,14H18V16H12V14M12,8H18V10H12V8M6,8H10V12H6V8M6,14H10V16H6V14Z" Fill="#94A3B8" IsHitTestVisible="False" Stretch="Uniform" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Width="130" Click="Aade_Click" Style="{StaticResource BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,8,0" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4V4.08C12,4.08 12,4.08 12,4C9.53,4.18 7.37,5.55 6.18,7.57L11.7,11.23L12,4M13,4L12.72,11.55L17.2,14.5C18.94,12.78 20,10.5 20,8C20,7.24 19.87,6.5 19.63,5.81C18.06,4.68 16.14,4 14.07,4H13M12,20A8,8 0 0,0 20,12C20,11.83 20,11.66 19.97,11.5L16.27,15.2C15.82,18.04 14.15,20 14.15,20H12M8,18.92C8.61,16.89 10.15,15.29 12.11,14.57L7.54,11.54C5.95,13.27 5,15.53 5,18C5,18.31 5.03,18.62 5.07,18.92H8M9.93,19.88C9.58,19.5 9.27,19.07 9,18.61C6.9,17.41 5.31,15.5 4.45,13.24C4.16,12.85 4,12.43 4,12C4,11.27 4.11,10.56 4.31,9.9C5.46,11.45 7.42,12.56 9.77,12.92L10.74,5.33C10.5,5.22 10.25,5.13 10,5.05C8,5.55 6.27,6.68 5.07,8.23C6.7,6.2 9.07,4.78 11.79,4.24L11,10.46L16.42,14.06C16.88,14.36 17.2,14.85 17.29,15.4C17.37,15.94 17.2,16.47 16.82,16.85L12.28,21.39C14.72,21.57 16.96,20.67 18.67,19.23L15.3,15.86C14.89,18.5 13.36,20.44 13.36,20.44C12.93,20.5 12.47,20.5 12,20.5C11.29,20.5 10.59,20.4 9.93,20.21L9.93,19.88Z" Fill="White" Stretch="Uniform" />
                                <TextBlock Text="ΑΑΔΕ" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="24,0,24,24" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" ClipToBounds="True" CornerRadius="12">
                <Grid>
                    <Border Height="4" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="LineStop1" Offset="0.0" Color="#0F172A" />
                                <GradientStop x:Name="LineStop2" Offset="0.5" Color="#3B82F6" />
                                <GradientStop x:Name="LineStop3" Offset="1.0" Color="#0F172A" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <DataGrid x:Name="RecordsGrid" Margin="0,4,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" ItemsSource="{Binding RecordsView}" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="3*" Binding="{Binding Επωνυμία}" Header="ΕΠΩΝΥΜΙΑ" IsReadOnly="True" />
                            <DataGridTextColumn Width="*" Binding="{Binding ΑΦΜ}" Header="Α.Φ.Μ." IsReadOnly="True" />
                            <DataGridTextColumn Width="*" Binding="{Binding Τηλέφωνο}" Header="ΤΗΛΕΦΩΝΟ" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
