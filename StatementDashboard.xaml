        xmlns:local="clr-namespace:EuroSearchApp" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="EuroStatement Dashboard" Width="1280" Height="800" Background="#F1F5F9" ResizeMode="CanResize" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" mc:Ignorable="d">

