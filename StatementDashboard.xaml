    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00CCCC" />
                    <GradientStop Offset="0.5" Color="#ffff" />
                    <GradientStop Offset="1.0" Color="#00CCCC" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Grid.Row="0" Margin="30,40,30,20">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Ellipse Width="16" Height="16" Margin="0,0,10,0" Fill="#660099" />
                <TextBlock FontSize="32" FontWeight="Bold" Foreground="#1E293B" Text="EuroStatement" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="#64748B" Text="Αρχείο Εκδοθέντων Πιστοποιητικών &amp; Δηλώσεων" />
            <Border Width="150" Height="3" Margin="0,25,0,0" CornerRadius="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="LineStop1" Offset="0.0" Color="#660099" />
                        <GradientStop x:Name="LineStop2" Offset="1.0" Color="#00CCCC" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="30">

            <Border Background="#AAFFFFFF" CornerRadius="20" Opacity="0.8" />

            <Border Padding="20" Background="White" CornerRadius="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Height="45" Margin="0,0,15,0" Background="#F1F5F9" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Margin="12" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z" Fill="#64748B" Stretch="Uniform" />
                                <TextBox x:Name="TxtSearch" Grid.Column="1" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="#1E293B" TextChanged="TxtSearch_TextChanged" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Width="45" Height="45" Click="AsyncBtnAddNewStatement_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#660099" CornerRadius="12">
                                        <Path Margin="10" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Stretch="Uniform" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#8A2BE2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <DataGrid Name="DtgFiles" Grid.Row="1" AlternatingRowBackground="#F8FAFC" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" FontSize="15" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" IsReadOnly="True"
                              MouseDoubleClick="DtgFiles_MouseDoubleClick" RowHeaderWidth="0" RowHeight="60">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="15,0" />
                                <Setter Property="Height" Value="50" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" Header="Όνομα Αρχείου">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Path Width="18" Height="22" Margin="0,0,12,0" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Fill="#660099" Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="{Binding FileName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="250" Binding="{Binding DateCreated}" Header="Ημερομηνία" />

                            <DataGridTemplateColumn Width="150" Header="Ενέργειες">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Height="35" Margin="5" Click="OpenPdf_Click" Content="Άνοιγμα" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>