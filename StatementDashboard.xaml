            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />
                    <ColorAnimation Storyboard.TargetName="LineStop1" Storyboard.TargetProperty="Color" From="#660099" To="#0066CC" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="LineStop2" Storyboard.TargetProperty="Color" From="#00CCCC" To="#33CC66" Duration="0:0:3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
