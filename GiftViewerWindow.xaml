<Window x:Class="EuroSearchApp.GiftViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroSearch - Κατάλογος Δώρων" Width="1000" Height="700" WindowStartupLocation="CenterOwner" WindowState="Normal">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" From="#660099" To="#660099" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="Stop2" Storyboard.TargetProperty="Color" From="#00CCCC" To="#33CC66" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="Stop3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />

                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.7" Duration="0:0:4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="back1" Offset="0.0" Color="#00CCCC" />
                <GradientStop x:Name="back2" Offset="0.5" Color="#fff" />
                <GradientStop x:Name="back3" Offset="1.0" Color="#00CCCC" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.Resources>
                <SolidColorBrush x:Key="Primary" Color="#3B82F6" />
                <SolidColorBrush x:Key="TextDark" Color="#0F172A" />
                <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
                <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
                <SolidColorBrush x:Key="HeaderBg" Color="#F1F5F9" />

                <Style x:Key="BtnDelete" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <Path x:Name="icon" Width="14" Height="14" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="#94A3B8" Stretch="Uniform" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2" />
                                        <Setter TargetName="icon" Property="Fill" Value="#EF4444" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGrid">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="RowHeaderWidth" Value="0" />
                    <Setter Property="GridLinesVisibility" Value="Horizontal" />
                    <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
                    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
                    <Setter Property="HeadersVisibility" Value="Column" />
                    <Setter Property="RowHeight" Value="48" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{StaticResource TextDark}" />
                    <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBg}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="Stop1" Offset="0.0" Color="#53DDDD" />
                        <GradientStop x:Name="Stop2" Offset="0.5" Color="#0066CC" />
                        <GradientStop x:Name="Stop3" Offset="1.0" Color="#660099" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Path Width="24" Height="24" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="White" Stretch="Uniform" />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" Text="Πλήρης Κατάλογος Δώρων" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="24" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,20" Background="White" CornerRadius="10">
                        <StackPanel Margin="24,15">
                            <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Text="Αναζήτηση στον κατάλογο" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtGiftSearch" Grid.Column="0" Height="40" Padding="10,0" VerticalContentAlignment="Center" TextChanged="TxtGiftSearch_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <Button Grid.Column="1" Width="40" Height="40" Margin="10,0,0,0" Background="#10B981" BorderThickness="0" Click="BtnAdd_Click" Cursor="Hand" ToolTip="Προσθήκη Νέου Δώρου">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <Path Width="16" Height="16" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Stretch="Uniform" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Width="40" Height="40" Margin="5,0,0,0" Background="#EF4444" BorderThickness="0" Click="BtnClear_Click" Cursor="Hand" ToolTip="Χωρίς Δώρο (Καθαρισμός)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <Path Width="16" Height="16" Data="M19,13H5V11H19V13Z" Fill="White" Stretch="Uniform" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" ClipToBounds="True" CornerRadius="5">
                        <DataGrid x:Name="GiftsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="GiftsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnDeleteRow_Click" Style="{StaticResource BtnDelete}" ToolTip="Διαγραφή Δώρου" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="*" Binding="{Binding [0]}" Header="ΠΕΡΙΓΡΑΦΗ ΔΩΡΟΥ">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            <Setter Property="Padding" Value="5,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="AddOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed">
                <Border Width="350" Padding="20" VerticalAlignment="Center" Background="White" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="0" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,15" FontSize="16" FontWeight="Bold" Text="Προσθήκη Νέου Δώρου" />

                        <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#64748B" Text="Ονομασία Δώρου:" />
                        <TextBox x:Name="TxtNewGift" Height="35" Padding="5,0" VerticalContentAlignment="Center" />

                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="80" Height="30" Margin="0,0,10,0" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Click="BtnCancelAdd_Click" Content="Ακύρωση" />
                            <Button Width="100" Height="30" Background="#3B82F6" BorderThickness="0" Click="BtnSaveNew_Click" Content="Αποθήκευση" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>