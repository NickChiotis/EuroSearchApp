<Window x:Class="EuroSearchApp.AadeSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ρυθμίσεις ΑΑΔΕ" Width="450" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Border Padding="20" Background="#F8FAFC">
        <StackPanel>
            <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Text="Ρυθμίσεις Σύνδεσης ΑΑΔΕ" />

            <TextBlock Margin="0,5" Foreground="#64748B" Text="Username (Ειδικός Κωδικός):" />
            <TextBox x:Name="TxtUser" Height="35" Padding="5" FontSize="14" />

            <TextBlock Margin="0,10,0,5" Foreground="#64748B" Text="Password (Ειδικός Κωδικός):" />
            <PasswordBox x:Name="TxtPass" Height="35" Padding="5" Background="White" FontSize="14" />

            <TextBlock Margin="0,10,0,5" Foreground="#64748B" Text="Το ΑΦΜ σας (afm_called_by):" />
            <TextBox x:Name="TxtMyAfm" Height="35" Padding="5" FontSize="14" />

            <Button Height="30" Margin="0,20,0,10" Background="#3B82F6" Click="TestConnection_Click" Content="Δοκιμή Σύνδεσης" Cursor="Hand" FontWeight="Bold" Foreground="White" />

            <TextBlock x:Name="LblStatus" Margin="0,0,0,15" Foreground="#64748B" Text="" TextWrapping="Wrap" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="80" Height="30" Margin="0,0,10,0" Background="Transparent" BorderBrush="#94A3B8" BorderThickness="1" Click="Cancel_Click" Content="Ακύρωση" />
                <Button Width="100" Height="30" Background="#10B981" Click="Save_Click" Content="Αποθήκευση" FontWeight="Bold" Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>