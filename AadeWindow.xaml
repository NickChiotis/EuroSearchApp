<Window x:Class="EuroSearchApp.AadeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:EuroSearchApp" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="AadeWindow" Width="800" Height="450" mc:Ignorable="d">
    <Border Padding="20" Background="#F8FAFC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F172A" Text="Έλεγχος Στοιχείων ΑΑΔΕ" />
                <TextBlock FontSize="12" Foreground="#64748B" Text="Αναζήτηση βάσει ΑΦΜ και ενημέρωση καρτέλας" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="ΑΦΜ προς αναζήτηση:" />
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearchAfm" Height="35" Padding="5" Background="#E2E8F0" FontSize="14" IsReadOnly="True" />
                    <Button Grid.Column="1" Width="120" Margin="10,0,0,0" Background="#3B82F6" Click="FetchAade_Click" Content="Ανάκτηση ΑΑΔΕ" Foreground="White" />
                </Grid>

                <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="Επωνυμία (Από ΑΑΔΕ):" />
                <TextBox x:Name="TxtResultName" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14" />

                <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="Διεύθυνση / Έδρα:" />
                <TextBox x:Name="TxtResultAddress" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14" />

                <TextBlock x:Name="TxtStatus" FontWeight="SemiBold" Foreground="Orange" Text="Αναμονή..." />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="100" Height="35" Margin="0,0,10,0" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Click="Cancel_Click" Content="Ακύρωση" />
                <Button Width="180" Height="35" Background="#10B981" Click="Save_Click" Content="Αποθήκευση &amp; Ενημέρωση" FontWeight="Bold" Foreground="White" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
