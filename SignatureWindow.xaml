<Window x:Class="EuroSearchApp.SignatureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EuroWheel - Ψηφιακή Υπογραφή" Width="600" Height="700" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                    <ColorAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Color" From="#00CCCC" To="#fff" Duration="0:0:3" />
                    <ColorAnimation Storyboard.TargetName="back2" Storyboard.TargetProperty="Color" From="#fff" To="#00CCCC" Duration="0:0:3" />
                    <DoubleAnimation Storyboard.TargetName="back1" Storyboard.TargetProperty="Offset" From="0.0" To="0.4" Duration="0:0:5" />
                    <DoubleAnimation Storyboard.TargetName="back3" Storyboard.TargetProperty="Offset" From="1.0" To="0.6" Duration="0:0:5" />

                    <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" From="#53DDDD" To="#660099" Duration="0:0:4" />
                    <DoubleAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Offset" From="0.0" To="0.3" Duration="0:0:4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="back1" Offset="0.0" Color="#00CCCC" />
                <GradientStop x:Name="back2" Offset="0.5" Color="#fff" />
                <GradientStop x:Name="back3" Offset="1.0" Color="#00CCCC" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid SnapsToDevicePixels="True">
            <Grid.Resources>
                <SolidColorBrush x:Key="Primary" Color="#3B82F6" />

                <Style x:Key="BtnPrimary" TargetType="Button">
                    <Setter Property="Height" Value="45" />
                    <Setter Property="Background" Value="{StaticResource Primary}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="70" Padding="20,0" CornerRadius="0,0,15,15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="Stop1" Offset="0.0" Color="#53DDDD" />
                        <GradientStop x:Name="Stop2" Offset="0.5" Color="#0066CC" />
                        <GradientStop x:Name="Stop3" Offset="1.0" Color="#660099" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="EuroWheel" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" FontSize="14" Foreground="White" Opacity="0.8" Text="SIGNATURE" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="30">

                <Border Margin="0,0,0,20" Padding="15" Background="White" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" />
                    </Border.Effect>
                    <CheckBox x:Name="ChkConsent" VerticalContentAlignment="Top">
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#334155" LineHeight="18" Text="ΣΥΝΑΙΝΩ για την τήρηση των προσωπικών μου στοιχείων απο τη Europharmacy ΙΚΕ για μελλοντική επικοινωνία με σκοπό την ενημέρωσή μου." TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <TextBlock Margin="5,0,0,10" FontWeight="SemiBold" Foreground="#475569" Text="Παρακαλώ υπογράψτε στο παρακάτω πλαίσιο:" />
                <Border Height="250" Background="White" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.05" ShadowDepth="5" />
                    </Border.Effect>
                    <Grid>
                        <InkCanvas x:Name="SignCanvas" Margin="5" Background="Transparent" />
                        <Line Margin="10,0,10,30" VerticalAlignment="Bottom" Stroke="#E2E8F0" StrokeThickness="1" X1="20" X2="500" Y1="230" Y2="230" />
                    </Grid>
                </Border>

                <TextBlock Margin="0,15,0,25" FontSize="11" FontStyle="Italic" Foreground="#64748B" Text="*Στην περίπτωση που επιθυμείτε να διαγραφούν τα προσωπικά σας στοιχεία από τη βάση δεδομένων της Europharmacy μπορείτε να ανακαλέσετε εγγράφως τη συγκατάθεσή σας ανά πάσα στιγμή." TextWrapping="Wrap" />

                <Button Click="BtnFinish_Click" Content="Ολοκλήρωση &amp; Επιβεβαίωση" Style="{StaticResource BtnPrimary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>